// Proof-gated IaC pipeline for Jenkins (declarative).
//
// The only thing Jenkins needs to know about Vizier is its exit code:
//   0 clean · 1 error · 2 changes pending · 3 proof-gate blocked
//
// The awkward part is Jenkins-specific, not Vizier-specific: `sh` fails the
// stage on ANY non-zero exit, which would turn "there are changes" - a normal,
// expected result - into a red build. `returnStatus: true` hands back the code
// instead of throwing, which is what makes the distinction expressible.

pipeline {
  agent any

  options {
    // Terraform state does not merge. Two concurrent applies against one
    // backend is how state gets corrupted, so runs are serialised.
    disableConcurrentBuilds()
    timestamps()
  }

  environment {
    VIZIER_VERSION = '1.0.1'
    VIZIER_DIR     = 'infrastructure'
    CATALOG_URL    = 'https://www.iac-bazaar.com'
    PLAN_DIR       = '.vizier-plans'
  }

  stages {

    stage('Install vizier') {
      steps {
        sh '''
          set -euo pipefail
          VERSION="${VIZIER_VERSION:-1.0.1}"
          # The asset name carries the version; the tag is `vizier/v<version>`.
          ASSET="vizier_${VERSION}_linux_amd64.tar.gz"
          BASE="https://github.com/CyberCoreSystems/vizier/releases/download/v${VERSION}"

          # Download under the asset's REAL name. checksums.txt refers to files
          # by that name, so saving it as vizier.tar.gz leaves the checksum with
          # nothing to match.
          curl -fsSL -o "$ASSET" "$BASE/$ASSET"
          curl -fsSL -o checksums.txt "$BASE/checksums.txt"

          # A tool whose whole purpose is verifying what you run has no business
          # installing itself unverified. Select this asset's line first: passing
          # the whole file with --ignore-missing skips every entry when the name
          # is wrong and dies with "no file was verified" -- fail-closed, but the
          # build never installs and never says which name was wrong.
          grep -F "$ASSET" checksums.txt | sha256sum --check -

          tar xzf "$ASSET"
          chmod +x vizier
        '''
      }
    }

    stage('Plan') {
      steps {
        script {
          // withCredentials keeps the values out of the build log; prefer an
          // IAM role on the agent over static keys where you can.
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-plan-role']]) {

            def code = sh(returnStatus: true, script: """
              ./vizier --dir '${env.VIZIER_DIR}' \
                       --catalog-url '${env.CATALOG_URL}' \
                       --verify-mode enforce \
                       run-all plan \
                       --plan-dir '${env.PLAN_DIR}' \
                       --detailed-exitcode \
                       --receipt vizier-receipt.json \
                       --receipt-md vizier-receipt.md
            """)

            // Record the receipt regardless of outcome. A receipt for a BLOCKED
            // run is the one you most want afterwards: "we were stopped, here
            // is what was refused and why".
            archiveArtifacts artifacts: 'vizier-receipt.*', allowEmptyArchive: true

            if (fileExists('vizier-receipt.md')) {
              // Surfaces the receipt on the build page rather than burying it
              // in console output nobody scrolls.
              writeFile file: 'receipt.html',
                        text: "<pre>${readFile('vizier-receipt.md').replace('<','&lt;')}</pre>"
              publishHTML(target: [reportDir: '.', reportFiles: 'receipt.html',
                                   reportName: 'Vizier receipt', keepAll: true,
                                   alwaysLinkToLastBuild: true, allowMissing: true])
            }

            switch (code) {
              case 0:
                echo 'No pending changes.'
                env.HAS_CHANGES = 'false'
                break
              case 2:
                // A result, not a failure.
                echo 'Plan has pending changes.'
                env.HAS_CHANGES = 'true'
                break
              case 3:
                // Distinguished on purpose: a gate refusal is a supply-chain
                // decision for a different reviewer than a broken plan.
                error('Proof-gate blocked: a module could not be proven verified. See the receipt.')
                break
              default:
                error("vizier plan failed (exit ${code})")
            }
          }
        }
        // Carry the plans to the apply stage. Without this, apply would
        // re-plan - and the approval would have been of a different plan.
        stash name: 'vizier-plans', includes: "${env.PLAN_DIR}/**", allowEmpty: true
      }
    }

    stage('Approve') {
      when {
        allOf {
          branch 'main'
          expression { env.HAS_CHANGES == 'true' }
        }
      }
      steps {
        // The proof-gate says the modules are verified. A human still says
        // whether this change should ship.
        timeout(time: 60, unit: 'MINUTES') {
          input message: 'Apply the reviewed plan?', ok: 'Apply'
        }
      }
    }

    stage('Apply') {
      when {
        allOf {
          branch 'main'
          expression { env.HAS_CHANGES == 'true' }
        }
      }
      steps {
        unstash 'vizier-plans'
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                          credentialsId: 'aws-apply-role']]) {
          script {
            def code = sh(returnStatus: true, script: """
              ./vizier --dir '${env.VIZIER_DIR}' \
                       --catalog-url '${env.CATALOG_URL}' \
                       --verify-mode enforce \
                       --auto-approve \
                       run-all apply \
                       --plan-dir '${env.PLAN_DIR}' \
                       --receipt vizier-apply-receipt.json
            """)
            archiveArtifacts artifacts: 'vizier-apply-receipt.json', allowEmptyArchive: true
            if (code == 3) {
              error('Proof-gate blocked during apply.')
            }
            if (code != 0) {
              error("vizier apply failed (exit ${code})")
            }
          }
        }
      }
    }
  }

  post {
    always {
      // The receipts are the audit trail; keep them even when the build failed.
      archiveArtifacts artifacts: 'vizier-*receipt*', allowEmptyArchive: true
    }
  }
}
